export function m1_f0(x: number): number {
  let acc = x + 1 * 0;
  acc = (acc * 2 + 1) % 1000003;
  acc = (acc * 3 + 2) % 1000003;
  acc = (acc * 4 + 3) % 1000003;
  acc = (acc * 5 + 4) % 1000003;
  acc = (acc * 6 + 5) % 1000003;
  acc = (acc * 7 + 6) % 1000003;

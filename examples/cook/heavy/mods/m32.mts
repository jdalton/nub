// module 32
export function m32_f0(x: number): number {
  let acc = x + 32 * 0;
  acc = (acc * 2 + 32) % 1000003;
  acc = (acc * 3 + 33) % 1000003;
  acc = (acc * 4 + 34) % 1000003;
  acc = (acc * 5 + 35) % 1000003;
  acc = (acc * 6 + 36) % 1000003;
  acc = (acc * 7 + 37) % 1000003;
  return acc;
}
